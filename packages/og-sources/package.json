{
  "name": "@hauska-engine/og-sources",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Oil & Gas data source adapters. RRC W-1 drilling permits, production data, and related O&G regulatory sources.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapters/rrc-w1": {
      "types": "./src/adapters/rrc-w1/index.ts",
      "import": "./src/adapters/rrc-w1/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@empressaio/atom-contract": "^1.13.0",
    "cheerio": "^1.0.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
