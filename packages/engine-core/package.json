    "@hauska-engine/storage": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "d3-contour": "^4.0.2",
    "geotiff": "^2.1.3",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
