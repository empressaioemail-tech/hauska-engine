{
  "name": "@hauska-engine/engine-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reasoning engines (briefing, finding, decomposition, precedence, calibration). Lifted from cortex-api lib/*-engine per ADR-008 / sprint 56.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./briefing": {
      "types": "./src/briefing/index.ts",
      "import": "./src/briefing/index.ts"
    },
    "./finding": {
      "types": "./src/finding/index.ts",
      "import": "./src/finding/index.ts"
    },
    "./calibration": {
      "types": "./src/calibration/overlay.ts",
      "import": "./src/calibration/overlay.ts"
    },
    "./site-topography": {
      "types": "./src/site-topography/index.ts",
      "import": "./src/site-topography/index.ts"
    },
    "./envelope": {
      "types": "./src/envelope/index.ts",
      "import": "./src/envelope/index.ts"
    },
    "./map-layers": {
      "types": "./src/map-layers/index.ts",
      "import": "./src/map-layers/index.ts"
    },
    "./property-reasoning": {
      "types": "./src/property-reasoning/index.ts",
      "import": "./src/property-reasoning/index.ts"
    },
    "./parcel-terrain": {
      "types": "./src/parcel-terrain/index.ts",
      "import": "./src/parcel-terrain/index.ts"
    },
    "./site-plan": {
      "types": "./src/site-plan/index.ts",
      "import": "./src/site-plan/index.ts"
    },
    "./road-intake": {
      "types": "./src/road-intake/index.ts",
      "import": "./src/road-intake/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'no lint configured'",
    "bake-property-atom-gold-set": "tsx scripts/bake-property-atom-gold-set.mjs",
    "bake-property-atom-county": "tsx scripts/bake-property-atom-county.mjs",
    "ingest-bastrop-roads-pilot": "tsx scripts/ingest-bastrop-roads-pilot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@empressaio/atom-contract": "^1.9.0",
    "@gltf-transform/core": "^4.2.1",
    "@hauska-engine/adapters": "workspace:*",
    "@hauska-engine/atoms": "workspace:*",
    "@hauska-engine/storage": "workspace:*",
    "d3-contour": "^4.0.2",
    "geotiff": "^2.1.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
