{
  "name": "@hauska-engine/atoms",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Engine-side atom-instance registry. Consumes @empressaio/atom-contract (via optional atom-contract-pin shim). Binds atom-type definitions to runtime atom instances per jurisdiction ingest.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@empressaio/atom-contract": "^1.30.0",
    "@hauska-engine/atom-contract-pin": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
