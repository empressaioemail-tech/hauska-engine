{
  "name": "@hauska-engine/atom-contract-pin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engine-side re-export shim over @empressaio/atom-contract (branding canon). Do not depend on legacy @hauska/atom-contract.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@empressaio/atom-contract": "^1.14.0"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
